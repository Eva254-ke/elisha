---
// src/components/Ministry.astro
import '../styles/ministry.css';
import SPMPhotoGallery from '../components/SPMPhotoGallery.astro';
---

<section class="ministry section-padding" id="ministry" aria-labelledby="ministry-title">
  <div class="container">
    
    <header class="section-header reveal">
      <h2 id="ministry-title" class="section-title">Ministry & Education</h2>
      <div class="divider"></div>
      <p class="section-subtitle">Equipping believers and scholars for the work of the Kingdom.</p>
    </header>

    <!-- Royal Family Church Section -->
    <div class="ministry-section reveal" id="spm">
      <div class="ministry-content">
        <h3 class="ministry-title">Royal Family Church - Thika</h3>
        
        <p class="vision-statement">
          <strong>Vision:</strong> Building people for kingdom influence
        </p>

        <div class="four-rs">
          <h4 class="rs-title">We:</h4>
          <ul class="rs-list">
            <li><span class="rs-letter">R</span>eceive</li>
            <li><span class="rs-letter">R</span>efresh</li>
            <li><span class="rs-letter">R</span>esource</li>
            <li><span class="rs-letter">R</span>elease</li>
          </ul>
        </div>

        <div class="service-times">
          <span class="time-label">Service Times:</span>
          <span class="time-value">8:30 AM & 10:30 AM</span>
        </div>

        <p class="ministry-desc">
          A vibrant community dedicated to teaching, preaching, and training believers in the Word of God. 
          Join us every Sunday for transformative worship and fellowship.
        </p>
      </div>
    </div>

    <!-- What We Offer Section -->
    <div class="ministry-section reveal">
      <h3 class="section-subtitle-alt">What We Offer</h3>
      <div class="offerings-grid">
        <div class="offering-item">
          <h4>Leadership Training</h4>
        </div>
        <div class="offering-item">
          <h4>Prophetic Ministry Training</h4>
        </div>
        <div class="offering-item">
          <h4>Theological Education</h4>
        </div>
        <div class="offering-item">
          <h4>Counseling & Mentorship</h4>
        </div>
        <div class="offering-item">
          <h4>Conference Speaker</h4>
        </div>
        <div class="offering-item">
          <h4>Author</h4>
        </div>
      </div>
    </div>

    <!-- SPM Section -->
    <div class="ministry-section reveal">
      <div class="spm-section">
        <h3 class="spm-title">School of Prophetic Ministry (S.P.M)</h3>
        
        <p class="spm-tagline">"Raising & Equipping a prophetic generation"</p>
        
        <p class="ministry-desc">
          Offering both physical and virtual classes to equip the next generation of prophetic voices 
          and church leaders. Our rigorous curriculum blends biblical theology with practical ministry skills.
        </p>

        <div class="spm-notice">
          <span class="notice-label">Intake</span>
          <span class="notice-date">Every January</span>
        </div>

        <div class="spm-contact">
          <a href="mailto:schoolofpropheticministry@gmail.com">schoolofpropheticministry@gmail.com</a>
        </div>

        <a href="https://wa.me/254723103042?text=Hello%20Dr.%20Elisha%2C%20I%27d%20like%20to%20apply%20for%20the%20School%20of%20Prophetic%20Ministry." target="_blank" rel="noopener noreferrer" class="btn btn-primary ministry-cta">Apply for SPM</a>
      </div>
    </div>

    <!-- SPM Photo Gallery -->
    <SPMPhotoGallery />

    <!-- Ministries Under Dr. Elisha -->
    <div class="ministry-section reveal" id="prophetic">
      <h3 class="section-subtitle-alt">Ministries under Dr. P.M. Elisha</h3>
      <div class="ministries-list">
        <div class="ministry-org">
          <h4>Prophetic Foundations International</h4>
          <p>A network of apostolic & prophetic leaders</p>
        </div>
        <div class="ministry-org">
          <h4>Good News Community Education Centre</h4>
          <p>Training & equipping through education</p>
        </div>
        <div class="ministry-org">
          <h4>Trumpet Publications</h4>
          <p>Publishing company for Christian resources</p>
        </div>
      </div>
    </div>

  </div>
</section>
