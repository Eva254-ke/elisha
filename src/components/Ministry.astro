---
// src/components/Ministry.astro
import '../styles/ministry.css';
---

<section class="ministry section-padding" aria-labelledby="ministry-title">
  <div class="container">
    
    <header class="section-header reveal">
      <h2 id="ministry-title" class="section-title">Ministry & Education</h2>
      <div class="divider"></div>
      <p class="section-subtitle">Equipping believers and scholars for the work of the Kingdom.</p>
    </header>

    <div class="ministry-grid">
      
      <article class="ministry-item reveal">
        <h3 class="ministry-title">Good News Family Church</h3>
        <address class="ministry-location">Kahawa Wendani, Nairobi</address>
        <p class="ministry-desc">
          A vibrant community dedicated to teaching, preaching, and training believers in the Word of God. Join us every Sunday for transformative worship and fellowship.
        </p>
        <a href="#" class="ministry-link">
          <span>Service Times & Location</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" width="16" height="16">
            <path d="M5 12h14M12 5l7 7-7 7" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"/>
          </svg>
        </a>
      </article>

      <article class="ministry-item ministry-featured reveal">
        <h3 class="ministry-title">Prophetic School of Ministry</h3>
        <address class="ministry-location">Ruiru, Kenya</address>
        <p class="ministry-desc">
          Equipping the next generation of prophetic voices and church leaders. Our rigorous curriculum blends biblical theology with practical ministry skills.
        </p>
        
        <div class="spm-notice">
          <span class="notice-label">Next Intake</span>
          <span class="notice-date">January 2027</span>
        </div>

        <a href="#" class="btn btn-primary ministry-cta">Apply for SPM</a>
      </article>

      <article class="ministry-item reveal">
        <h3 class="ministry-title">Academic Mentorship</h3>
        <address class="ministry-location">University Lecture Halls</address>
        <p class="ministry-desc">
          Bridging the gap between faith and reason. Passionate about mentoring university students, fostering critical thinking, and developing ethical future leaders.
        </p>
        <a href="#" class="ministry-link">
          <span>Teaching Philosophy</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" width="16" height="16">
            <path d="M5 12h14M12 5l7 7-7 7" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"/>
          </svg>
        </a>
      </article>

    </div>
  </div>
</section>