---
// src/components/Support.astro
import '../styles/support.css';
---

<section class="support section-padding" aria-labelledby="support-title">
  <div class="container">  
    <div class="support-wrapper reveal-children">
      
      <div class="support-content">
        <h2 id="support-title" class="support-title">Support the Ministry</h2>
        <p class="support-text">
          Your partnership helps us continue teaching, preaching, and training the next generation 
          of leaders. Every contribution, no matter the size, advances the Kingdom and supports 
          our work in the church, university, and through our written resources.
        </p>
        
        <div class="support-verse">
          <p class="verse-text">"Each of you should give what you have decided in your heart to give, 
          not reluctantly or under compulsion, for God loves a cheerful giver."</p>
          <span class="verse-ref">— 2 Corinthians 9:7</span>
        </div>
      </div>

      <div class="support-actions">
        
        <!-- Ko-fi Floating Widget -->
        <div class="kofi-container">
          <script type="text/javascript" src="https://storage.ko-fi.com/cdn/scripts/overlay-widget.js"></script>
          <script>
            (window as any).kofiWidgetOverlay?.draw('peterelisha', {
              'type': 'floating-chat',
              'floating-chat.donateButton.text': 'Support',
              'floating-chat.donateButton.background-color': '#C9A961',
              'floating-chat.donateButton.text-color': '#1B2A4E'
            });
          </script>
        </div>
        
        <!-- Fallback Static Button -->
        <a 
          href="https://ko-fi.com/peterelisha" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="kofi-button"
          aria-label="Support on Ko-fi"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true">
            <path d="M12.031 6.172c-1.191 0-2.229.701-2.721 1.718-.492-1.017-1.53-1.718-2.721-1.718-1.719 0-3.109 1.391-3.109 3.109 0 3.656 5.344 9.281 8.156 12.094l.391.391.391-.391c2.812-2.813 8.156-8.438 8.156-12.094 0-1.718-1.39-3.109-3.109-3.109-.516 0-1.016.141-1.453.391l-.563.328-.563-.328c-.437-.25-.937-.391-1.453-.391z"/>
          </svg>
          <span class="kofi-text">Support</span>
        </a>

        <p class="kofi-note">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" width="14" height="14" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Secure payment • 0% platform fees • International cards accepted
        </p>

      </div>

    </div>
  </div>
</section>