
---
// src/components/Hero.astro
import '../styles/hero.css';
---

<section class="hero" aria-label="Introduction">
  <div class="container hero-container">
    
    <!-- Text Content (Left on Desktop, Bottom on Mobile) -->
    <div class="hero-content reveal-children">
      
      <p class="hero-tagline">Church Minister · Leader · Educator · Author · Entrepreneur</p>
      
      <h1 class="hero-title">
        Dr. Peter Muriithi <br />
        <span class="text-gold">Elisha</span>
      </h1>
      
      <p class="hero-script">"Sharing the Bread of Life — Bringing hope to Humanity"</p>
      
      <p class="hero-description">
        Equipping the next generation of leaders through the pulpit, the lecture hall, and the written word. 
        Bridging deep theological insight with academic excellence and entrepreneurial vision.
      </p>
      
      <div class="hero-actions">
        <a href="#books" class="btn btn-primary">Explore My Books</a>
        <a href="#ministry" class="btn btn-secondary">Join the Ministry</a>
      </div>

    </div>

    <!-- Image Content (Right on Desktop, Top on Mobile) -->
    <div class="hero-media reveal">
      <img 
        src="https://i.ibb.co/0p1q5Xnq/image.png" 
        alt="Dr. Peter Muriithi Elisha Portrait" 
        width="800" 
        height="1000"
        loading="eager"
        class="hero-image"
      />
    </div>

  </div>
</section>