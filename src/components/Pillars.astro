---
// src/components/Pillars.astro
import '../styles/pillars.css';
---

<section class="pillars section-padding" aria-labelledby="pillars-title">
  <div class="container">
    
    <header class="section-header reveal">
      <h2 id="pillars-title" class="section-title">The Three Pillars</h2>
      <div class="divider"></div>
      <p class="section-subtitle">A life dedicated to church leadership, training, and prophetic ministry.</p>
    </header>

    <div class="pillars-grid">
      
      <!-- Pillar 1: Church Leadership -->
      <article class="pillar-item reveal">
        <h3 class="pillar-title">Church Leadership</h3>
        <p class="pillar-desc">
          Founding father of Royal Family Church - Thika, holding leadership positions in organizations like Joyland Bible. Driven by the core vision: <em>"Building people for kingdom influence."</em>
        </p>
        <a href="#ministry" class="pillar-link">
          <span>View Ministry</span>
        </a>
      </article>

      <!-- Pillar 2: Training & Equipping -->
      <article class="pillar-item reveal">
        <h3 class="pillar-title">Training & Equipping</h3>
        <p class="pillar-desc">
          Leading the School of Prophetic Ministry (S.P.M) to raise and equip a prophetic generation. Offering both physical and virtual classes, with new intakes every January.
        </p>
        <a href="https://wa.me/254723103042?text=Hello%20Dr.%20Elisha%2C%20I%27d%20like%20to%20learn%20about%20the%20School%20of%20Prophetic%20Ministry." target="_blank" rel="noopener noreferrer" class="pillar-link">
          <span>Explore S.P.M</span>
        </a>
      </article>

      <!-- Pillar 3: Prophetic Ministry -->
      <article class="pillar-item reveal">
        <h3 class="pillar-title">Prophetic Ministry</h3>
        <p class="pillar-desc">
          Founder of Prophetic Foundations International and founding member of CANAT. Overseeing a growing network of apostolic and prophetic leaders and churches.
        </p>
        <a href="#prophetic" class="pillar-link">
          <span>Learn More</span>
        </a>
      </article>

    </div>
  </div>
</section>
