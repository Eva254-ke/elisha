---
// src/components/Pillars.astro
import '../styles/pillars.css';
---

<section class="pillars section-padding" aria-labelledby="pillars-title">
  <div class="container">
    
    <header class="section-header reveal">
      <h2 id="pillars-title" class="section-title">The Three Pillars</h2>
      <div class="divider"></div>
      <p class="section-subtitle">A life dedicated to church, education, and the written word.</p>
    </header>

    <div class="pillars-grid">
      
      <article class="pillar-item reveal">
        <h3 class="pillar-title">Church Leader</h3>
        <p class="pillar-desc">
          Serving as a shepherd at Good News Family Church in Kahawa Wendani. Dedicated to teaching the Word, fostering community, and spiritual formation.
        </p>
        <a href="#ministry" class="pillar-link">
          <span>View Ministry</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" width="16" height="16">
            <path d="M5 12h14M12 5l7 7-7 7" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"/>
          </svg>
        </a>
      </article>

      <article class="pillar-item reveal">
        <h3 class="pillar-title">University Educator</h3>
        <p class="pillar-desc">
          Mentoring the next generation of scholars. Bridging academic rigor and spiritual truth in the lecture hall.
        </p>
        <a href="#about" class="pillar-link">
          <span>Teaching Philosophy</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" width="16" height="16">
            <path d="M5 12h14M12 5l7 7-7 7" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"/>
          </svg>
        </a>
      </article>

      <article class="pillar-item reveal">
        <h3 class="pillar-title">Published Author</h3>
        <p class="pillar-desc">
          Exploring deep theological themes through the written word. Author of <em>Prodigal Son, Patient Father</em> and other resources.
        </p>
        <a href="#books" class="pillar-link">
          <span>Explore Books</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" width="16" height="16">
            <path d="M5 12h14M12 5l7 7-7 7" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"/>
          </svg>
        </a>
      </article>

    </div>
  </div>
</section>