---
// src/components/BookShowcase.astro
import '../styles/book-showcase.css';
---

<section class="book-showcase section-padding" id="books" aria-labelledby="book-title">
  <div class="container">
    
    <!-- FEATURED BOOK -->
    <div class="book-grid">
      
      <div class="book-visual reveal">
        <div class="book-cover-wrapper">
          <img 
            src="/images/books/prodigal-son-patient-father.jpg"
            alt="Prodigal Son, Patient Father Book Cover" 
            width="600" 
            height="900"
            loading="lazy"
            class="book-cover"
          />
        </div>
      </div>

      <div class="book-content reveal-children">
        <p class="book-meta">Theology & Spiritual Growth</p>
        <h2 id="book-title" class="book-title">Prodigal Son, <br /><span class="text-gold">Patient Father</span></h2>
        <p class="book-author">By Dr. Peter Muriithi Elisha</p>
        
        <p class="book-description">
          A profound exploration of grace, redemption, and the enduring nature of divine love. This seminal work unpacks the beloved parable through a fresh, culturally rich theological lens.
        </p>

        <div class="book-actions">
          <a href="https://www.amazon.com/dp/ProdigalSonPatientFather" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" width="18" height="18" style="margin-right: 0.5rem;">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <line x1="3" y1="6" x2="21" y2="6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M16 10a4 4 0 0 1-8 0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Order on Amazon
          </a>
          <a href="#" class="btn btn-secondary">Read Free Chapter</a>
        </div>
      </div>
    </div>

    <!-- MORE PUBLISHED WORKS -->
    <div class="more-works-section">
      <div class="divider"></div>
      <h3 class="more-works-title">More Published Works</h3>
      <p class="more-works-subtitle">Exploring deep theological themes through the written word.</p>
      
      <div class="books-grid">
        
        <div class="book-card">
          <div class="book-cover-wrapper">
            <img 
              src="/images/books/marriage-works-today.jpg"
              alt="Marriage Works Today Book Cover" 
              width="300" 
              height="450"
              loading="lazy"
              class="book-cover"
            />
          </div>
          <div class="book-info">
            <p class="book-meta">Marriage & Family</p>
            <h4 class="book-card-title">Marriage Works Today</h4>
            <p class="book-author">By Peter &amp; Asnath Muriithi</p>
            <p class="book-card-desc">Biblical principles for building a strong, lasting, and joyful marriage.</p>
            <a href="https://wa.me/254723103042" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-small">Order Copy</a>
          </div>
        </div>

        <div class="book-card">
          <div class="book-cover-wrapper">
            <img 
              src="/images/books/unveiling-the-deception.jpg"
              alt="Unveiling the Deception Book Cover" 
              width="300" 
              height="450"
              loading="lazy"
              class="book-cover"
            />
          </div>
          <div class="book-info">
            <p class="book-meta">Apologetics</p>
            <h4 class="book-card-title">Unveiling the Deception</h4>
            <p class="book-author">By Dr. Peter Muriithi Elisha</p>
            <p class="book-card-desc">Understanding and overcoming spiritual deception in the modern age.</p>
            <a href="https://wa.me/254723103042" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-small">Order Copy</a>
          </div>
        </div>

        <div class="book-card">
          <div class="book-cover-wrapper">
            <img 
              src="/images/books/responding-to-the-call.jpg"
              alt="Responding to the Call Book Cover" 
              width="300" 
              height="450"
              loading="lazy"
              class="book-cover"
            />
          </div>
          <div class="book-info">
            <p class="book-meta">Vocation & Purpose</p>
            <h4 class="book-card-title">Responding to the Call</h4>
            <p class="book-author">By Dr. Peter Muriithi Elisha</p>
            <p class="book-card-desc">Navigating your divine purpose and stepping into your God-given destiny.</p>
            <a href="https://wa.me/254723103042" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-small">Order Copy</a>
          </div>
        </div>

      </div>
    </div>

    <!-- SHOW MORE BUTTON -->
    <div class="show-more-section reveal">
      <div class="center-button">
        <a href="/book-show" class="btn btn-secondary btn-large">
          Show More
        </a>
      </div>
    </div>

  </div>
</section>
