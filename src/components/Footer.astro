---
// src/components/Footer.astro
import '../styles/footer.css';
---

<footer class="site-footer" aria-label="Site Footer">
  <div class="container">
    
    <div class="footer-signature reveal">
      <p class="signature-text">"Teach us to number our days, that we may gain a heart of wisdom."</p>
      <span class="signature-ref">— Psalm 90:12</span>
    </div>

    <div class="footer-main">
      
      <div class="footer-brand">
        <a href="/" class="footer-logo">Dr. P. M. Elisha</a>
        <p class="footer-tagline">Church Leader · Educator · Author</p>
        
        <nav class="footer-nav" aria-label="Footer Navigation">
          <ul class="footer-nav-list">
            <li><a href="#about" class="footer-link">About</a></li>
            <li><a href="#ministry" class="footer-link">Ministry</a></li>
            <li><a href="#books" class="footer-link">Books</a></li>
            <li><a href="#contact" class="footer-link">Contact</a></li>
          </ul>
        </nav>
      </div>

      <div class="footer-connect">
        <h4 class="footer-heading">Connect</h4>
        <div class="footer-social">
          <a href="https://facebook.com/profile.php?id=100051497867707" target="_blank" rel="noopener" class="footer-social-link" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" width="20" height="20">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round"/>
            </svg>
            <span>Facebook</span>
          </a>
          <a href="#" target="_blank" rel="noopener" class="footer-social-link" aria-label="YouTube">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" width="20" height="20">
              <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.33 29 29 0 0 0-.46-5.33z" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round"/>
              <path d="M9.75 15.02l5.75-3.27-5.75-3.27v6.54z" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round"/>
            </svg>
            <span>YouTube</span>
          </a>
          <a href="https://wa.me/254723103042" target="_blank" rel="noopener" class="footer-social-link" aria-label="WhatsApp">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.008-.57-.008-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            <span>WhatsApp</span>
          </a>
        </div>

        <div class="footer-location">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" width="16" height="16">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round"/>
            <circle cx="12" cy="10" r="3" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round"/>
          </svg>
          <span>Nairobi, Kenya</span>
        </div>
      </div>

      <div class="footer-services">
        <h4 class="footer-heading">Elisha Offers</h4>
        <ul class="footer-services-list">
          <li><a href="#ministry" class="footer-service-link">Leadership Training</a></li>
          <li><a href="#ministry" class="footer-service-link">Prophetic Ministry Training</a></li>
          <li><a href="#ministry" class="footer-service-link">Theological Education</a></li>
          <li><a href="#ministry" class="footer-service-link">Counseling & Mentorship</a></li>
          <li><a href="#ministry" class="footer-service-link">Conference Speaker</a></li>
          <li><a href="#books" class="footer-service-link">Author (Books, papers, and manuals)</a></li>
        </ul>
      </div>

    </div>

    <div class="footer-bottom">
      <p class="copyright">
        © <span id="year"></span> Dr. Peter Muriithi Elisha. All rights reserved.
      </p>
      <a href="#top" class="back-to-top">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" width="16" height="16">
          <path d="M12 19V5M5 12l7-7 7 7" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"/>
        </svg>
        Back to top
      </a>
    </div>

  </div>
</footer>

<!-- Dynamic Year Script -->
<script>
  const yearEl = document.getElementById('year');
  if (yearEl) yearEl.textContent = String(new Date().getFullYear());
</script>